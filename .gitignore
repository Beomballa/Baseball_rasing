# Default deny: track only source and the files required to build/review it.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/BM/
/BM/**
!/BM/**/
!/BM/**/*.swift
!/BM/Resources/schools.json
!/BMTests/
/BMTests/**
!/BMTests/**/
!/BMTests/**/*.swift
!/BMUITests/
/BMUITests/**
!/BMUITests/**/
!/BMUITests/**/*.swift
!/BM.xcodeproj/
/BM.xcodeproj/**
!/BM.xcodeproj/xcshareddata/
!/BM.xcodeproj/xcshareddata/xcschemes/
!/BM.xcodeproj/project.pbxproj
!/BM.xcodeproj/xcshareddata/xcschemes/BM.xcscheme
!/.githooks/
/.githooks/*
!/.githooks/pre-commit
!/.githooks/commit-msg
!/scripts/
/scripts/*
!/scripts/check_staged.py
!/scripts/check_commit_message.py
!/scripts/test_git_security.py

# Always private/local, including files placed inside an allowed source folder.
**/.DS_Store
**/.env
**/.env.*
**/Secrets/
**/secrets/
**/credentials/
**/.ssh/
**/.aws/
**/.idea/
**/.vscode/
**/xcuserdata/

# Shared local tooling and generated-file exclusions.
# Restrict hidden source subdirectories; keep shared root Git hooks/settings above.
/BM/**/.*/
/BMTests/**/.*/
/BMUITests/**/.*/
**/generated/
**/*.iws
**/*.iml
**/*.ipr
**/*.sql
**/*.xcuserstate
**/*.local.xcconfig
**/GoogleService-Info.plist
**/AuthKey_*
**/*.p8
**/*.p12
**/*.pfx
**/*.pem
**/*.key
**/*.cer
**/*.mobileprovision
**/*.provisionprofile
**/*.keystore
**/*.jks
**/*.sqlite*
**/*.store*
**/*.db
**/*.log
**/*.xcresult/
**/*.xcarchive/
**/*.ipa
**/*.dSYM/
**/__pycache__/
/qa/
/DerivedData/
/build/
/.build/
